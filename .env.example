# ─── ALIVE Studio environment ────────────────────────────────────────────────

# ─── Auth.js ────────────────────────────────────────────────────────────────
# 32+ random bytes — generate with: openssl rand -base64 32
AUTH_SECRET=
# Required in prod when behind a proxy (Vercel handles this automatically)
# AUTH_URL=https://wearealive.in

# Optional email magic-link provider for brand/admin login (SMTP)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=hello@wearealive.in

# ─── PostgreSQL (Neon recommended for Vercel) ────────────────────────────────
# Pooled connection (used by Prisma at runtime in serverless)
DATABASE_URL=postgresql://user:pass@pooler.host/db?sslmode=require
# Direct connection for migrations (Neon: same URL but with -pooler removed)
DATABASE_DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# ─── Upstash Redis (cache + rate limiting) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudflare R2 (media storage) ───────────────────────────────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=alive-media
# Public-read base URL (custom domain or pub-<account>.r2.dev)
R2_PUBLIC_BASE=https://media.wearealive.in

# ─── Razorpay (brand campaign payments) ──────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Admin password (legacy /admin endpoints) ────────────────────────────────
# Will be replaced by Auth.js role=ADMIN once auth migration is complete
ADMIN_PASSWORD=

# ─── ALIVE Player APK (Android TV ad player) ─────────────────────────────────
# Override these to change the APK download links in the admin Screens tab
# without touching source code. Leave blank to use the built-in defaults.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=in.wearealive.player
NEXT_PUBLIC_APK_DIRECT_URL=https://pub-7a9bd7006a434f6c84ea68e69b323918.r2.dev/alive-player-latest.apk

# ─── Clerk (LEGACY — to be removed after Auth.js migration) ──────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# ─── Content transcode Lambda (see TRANSCODE_LAMBDA.md for one-time setup) ───
# Re-encodes uploaded videos to H.264 Main@4.1 so they hardware-decode reliably
# on budget Android TV SoCs (Realtek, Amlogic, Allwinner) that reject High
# Profile/Level 5.0 sources. Leave blank to disable (uploads keep original format).
# TRANSCODE_LAMBDA_FUNCTION_NAME=alive-transcode
# TRANSCODE_LAMBDA_REGION=ap-south-1
# TRANSCODE_AWS_ACCESS_KEY_ID=
# TRANSCODE_AWS_SECRET_ACCESS_KEY=
# TRANSCODE_CALLBACK_SECRET=

# ─── eWeLink / Sonoff smart plugs (per-screen power switch + telemetry) ──────
# OAuth app from https://dev.ewelink.cc — whitelist <site>/api/ewelink/callback
# as the redirect URL. Leave blank to hide the Power card in admin > Screens.
EWELINK_APP_ID=
EWELINK_APP_SECRET=
