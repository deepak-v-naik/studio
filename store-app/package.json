{
  "name": "alive-store-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:android": "node -e \"if(!require('fs').existsSync('google-services.json')){console.error('google-services.json missing — push notifications will be silently dead in this build. See DEPLOYMENT.md § Push notifications.');process.exit(1)}\" && eas build --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~52.0.46",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.2",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.3",
    "expo-document-picker": "~13.0.2",
    "expo-file-system": "~18.0.11",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.4",
    "expo-location": "~18.0.4",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.20",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
